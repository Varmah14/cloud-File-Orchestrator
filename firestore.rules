rules_version = '2';

// Defense-in-depth for the API's application-layer auth check
// (services/api/main.py's require_uid dependency). This matters
// specifically if a client ever reads Firestore directly (e.g. a
// real-time onSnapshot listener) instead of always going through the
// API -- the Admin SDK the API/workers use bypasses these rules
// entirely, so this only applies to client SDK access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
